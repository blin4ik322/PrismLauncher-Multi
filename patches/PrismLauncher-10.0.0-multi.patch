 void MainWindow::on_actionLaunchInstance_triggered()
 {
-    if (m_selectedInstance && !m_selectedInstance->isRunning()) {
+    if (!m_selectedInstance)
+        return;
+
+    if (!m_selectedInstance->isRunning()) {
         APPLICATION->launch(m_selectedInstance);
+        return;
+    }
+
+#ifdef Q_OS_WIN
+    auto accounts = APPLICATION->accounts();
+    QStringList choices;
+    int defaultIndex = 0;
+    for (int i = 0; i < accounts->count(); ++i) {
+        const auto account = accounts->at(i);
+        const QString kind = account->accountType() == AccountType::Offline ? tr("offline") : tr("Microsoft");
+        choices.append(tr("%1 (%2) #%3").arg(account->profileName(), kind).arg(i + 1));
+        if (account == accounts->defaultAccount())
+            defaultIndex = i;
+    }
+    const int offlineChoice = choices.size();
+    choices.append(tr("Other offline nickname..."));
+
+    bool accepted = false;
+    const QString choice = QInputDialog::getItem(this, tr("Launch another window"), tr("Account for the new window:"),
+                                                 choices, defaultIndex, false, &accepted);
+    if (!accepted)
+        return;
+
+    QString profile;
+    QString nickname;
+    const int choiceIndex = choices.indexOf(choice);
+    if (choiceIndex < 0)
+        return;
+    if (choiceIndex == offlineChoice) {
+        const auto defaultAccount = accounts->defaultAccount();
+        const QString suggestedName = defaultAccount ? defaultAccount->profileName() : QString();
+        nickname = QInputDialog::getText(this, tr("Launch another window"), tr("Offline nickname:"),
+                                         QLineEdit::Normal, suggestedName, &accepted).trimmed();
+        if (!accepted)
+            return;
+    } else {
+        profile = accounts->at(choiceIndex)->profileName();
+        nickname = profile;
+    }
+    if (!QRegularExpression(QStringLiteral("^[A-Za-z0-9_]{3,16}$")).match(nickname).hasMatch()) {
+        QMessageBox::warning(this, tr("Invalid nickname"),
+                             tr("Use 3 to 16 Latin letters, digits, or underscores."));
+        return;
     }
+
+    const QString helper = QDir(QApplication::applicationDirPath()).filePath(QStringLiteral("Prism Multi.ps1"));
+    if (!QFileInfo::exists(helper)) {
+        QMessageBox::critical(this, tr("Cannot launch another window"),
+                              tr("The multi-launch helper is missing: %1").arg(helper));
+        return;
+    }
+    QStringList args{ QStringLiteral("-NoProfile"), QStringLiteral("-ExecutionPolicy"),
+                      QStringLiteral("Bypass"), QStringLiteral("-STA"), QStringLiteral("-WindowStyle"),
+                      QStringLiteral("Hidden"), QStringLiteral("-File"), helper,
+                      QStringLiteral("-InstanceId"), m_selectedInstance->id(),
+                      QStringLiteral("-PrismExe"), QApplication::applicationFilePath(),
+                      QStringLiteral("-DataDir"), APPLICATION->dataRoot(),
+                      QStringLiteral("-InstancePath"), m_selectedInstance->instanceRoot() };
+    if (profile.isEmpty())
+        args.append({ QStringLiteral("-Nickname"), nickname });
+    else
+        args.append({ QStringLiteral("-Profile"), profile });
+    if (!QProcess::startDetached(QStringLiteral("powershell.exe"), args)) {
+        QMessageBox::critical(this, tr("Cannot launch another window"), tr("Could not start the multi-launch helper."));
+    }
+#endif
 }
 
