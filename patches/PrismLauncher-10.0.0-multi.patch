diff --git a/launcher/resources/Prism Multi.ps1 b/launcher/resources/Prism Multi.ps1
new file mode 100644
index 0000000..05a23dd
--- /dev/null
+++ b/launcher/resources/Prism Multi.ps1	
@@ -0,0 +1,155 @@
+param(
+    [string]$InstanceId,
+    [string]$Nickname,
+    [string]$Profile,
+    [string]$PrismExe,
+    [string]$DataDir,
+    [string]$InstancePath,
+    [switch]$PrepareOnly,
+    [string]$DestinationBase
+)
+
+Add-Type -AssemblyName System.Windows.Forms
+Add-Type -AssemblyName System.Drawing
+
+$ErrorActionPreference = 'Stop'
+$prismExe = if ($PrismExe) { $PrismExe } else { Join-Path $env:LOCALAPPDATA 'Programs\PrismLauncher\prismlauncher.exe' }
+$prismData = if ($DataDir) { $DataDir } else { Join-Path $env:APPDATA 'PrismLauncher' }
+$instanceDir = Join-Path $prismData 'instances'
+if (-not $DestinationBase) { $DestinationBase = Join-Path (Split-Path -Parent $prismData) 'PrismLauncher-Multi' }
+
+function Show-Error([string]$Message) {
+    [System.Windows.Forms.MessageBox]::Show($Message, 'Prism Multi', 'OK', 'Error') | Out-Null
+}
+
+function Set-IniValue([string]$Path, [string]$Key, [string]$Value) {
+    $lines = [System.Collections.Generic.List[string]]::new()
+    if (Test-Path -LiteralPath $Path) { $lines.AddRange([string[]](Get-Content -LiteralPath $Path)) }
+    $found = $false
+    for ($i = 0; $i -lt $lines.Count; $i++) {
+        if ($lines[$i] -match ('^' + [regex]::Escape($Key) + '=')) {
+            $lines[$i] = "$Key=$Value"
+            $found = $true
+        }
+    }
+    if (-not $found) { $lines.Add("$Key=$Value") }
+    [System.IO.File]::WriteAllLines($Path, $lines, [System.Text.UTF8Encoding]::new($false))
+}
+
+function New-MultiLaunch([string]$Id, [string]$Name, [string]$ProfileName) {
+    if (-not (Test-Path -LiteralPath $prismExe)) { throw 'PrismLauncher не найден по ожидаемому пути.' }
+    if ($ProfileName) { $Name = $ProfileName }
+    if ($Name -cnotmatch '^[A-Za-z0-9_]{3,16}$') { throw 'Ник должен содержать 3–16 латинских букв, цифр или символов подчёркивания.' }
+    $source = if ($InstancePath) { $InstancePath } else { Join-Path $instanceDir $Id }
+    if (-not (Test-Path -LiteralPath (Join-Path $source 'instance.cfg'))) { throw 'Выбранная сборка не найдена.' }
+
+    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
+    $suffix = [guid]::NewGuid().ToString('N').Substring(0, 6)
+    $root = Join-Path $DestinationBase ("{0}_{1}_{2}" -f $stamp, $Id.Replace(' ', '_'), $suffix)
+    $targetInstances = Join-Path $root 'instances'
+    $target = Join-Path $targetInstances $Id
+    [System.IO.Directory]::CreateDirectory($targetInstances) | Out-Null
+
+    try {
+        foreach ($folder in @('assets', 'libraries', 'java', 'meta', 'cache', 'icons', 'catpacks', 'translations')) {
+            $from = Join-Path $prismData $folder
+            if (Test-Path -LiteralPath $from) {
+                New-Item -ItemType Junction -Path (Join-Path $root $folder) -Target $from | Out-Null
+            }
+        }
+        foreach ($file in @('prismlauncher.cfg', 'accounts.json')) {
+            $from = Join-Path $prismData $file
+            if (Test-Path -LiteralPath $from) { Copy-Item -LiteralPath $from -Destination (Join-Path $root $file) }
+        }
+        $cfg = Join-Path $root 'prismlauncher.cfg'
+        Set-IniValue $cfg 'InstanceDir' 'instances'
+        Set-IniValue $cfg 'QuitAfterGameStop' 'true'
+        Set-IniValue $cfg 'CloseAfterLaunch' 'true'
+
+        # A running world's files can change during copying. New windows start without copied saves.
+        $exclude = @(
+            (Join-Path $source 'minecraft\saves'),
+            (Join-Path $source '.minecraft\saves'),
+            (Join-Path $source 'minecraft\world'),
+            (Join-Path $source '.minecraft\world')
+        )
+        & robocopy.exe $source $target /E /XJ /XD $exclude /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null
+        if ($LASTEXITCODE -ge 8) { throw "Не удалось скопировать сборку (код $LASTEXITCODE)." }
+        if (-not (Test-Path -LiteralPath (Join-Path $target 'instance.cfg'))) { throw 'Копия сборки не создана.' }
+        Set-IniValue (Join-Path $target 'instance.cfg') 'name' ("$Id [$Name, $stamp]")
+        [System.IO.File]::WriteAllText((Join-Path $root 'Prism Multi.txt'), "Original: $Id`r`nProfile: $ProfileName`r`nNickname: $Name`r`nCreated: $(Get-Date -Format o)`r`n")
+
+        if (-not $PrepareOnly) {
+            $launchArgs = @('--dir', ('"' + $root + '"'), '--launch', ('"' + $Id + '"'))
+            if ($ProfileName) { $launchArgs += @('--profile', $ProfileName) }
+            else { $launchArgs += @('--offline', $Name) }
+            Start-Process -FilePath $prismExe -ArgumentList $launchArgs | Out-Null
+        }
+        return $root
+    }
+    catch {
+        # Keep an incomplete copy for diagnosis instead of risking deletion of game data.
+        throw
+    }
+}
+
+if ($InstanceId -and ($Nickname -or $Profile)) {
+    try { New-MultiLaunch $InstanceId $Nickname $Profile | Write-Output }
+    catch { Show-Error $_.Exception.Message; exit 1 }
+    exit 0
+}
+
+$instances = @(Get-ChildItem -LiteralPath $instanceDir -Directory | Where-Object { Test-Path -LiteralPath (Join-Path $_.FullName 'instance.cfg') } | Sort-Object Name)
+if ($instances.Count -eq 0) { Show-Error 'Сборки PrismLauncher не найдены.'; exit 1 }
+
+$form = New-Object System.Windows.Forms.Form
+$form.Text = 'Prism Multi — ещё одно окно Minecraft'
+$form.Size = New-Object System.Drawing.Size(465, 235)
+$form.StartPosition = 'CenterScreen'
+$form.FormBorderStyle = 'FixedDialog'
+$form.MaximizeBox = $false
+
+$instanceLabel = New-Object System.Windows.Forms.Label
+$instanceLabel.Text = 'Сборка:'
+$instanceLabel.Location = New-Object System.Drawing.Point(18, 20)
+$instanceLabel.AutoSize = $true
+$form.Controls.Add($instanceLabel)
+
+$combo = New-Object System.Windows.Forms.ComboBox
+$combo.Location = New-Object System.Drawing.Point(18, 44)
+$combo.Size = New-Object System.Drawing.Size(410, 26)
+$combo.DropDownStyle = 'DropDownList'
+foreach ($item in $instances) { [void]$combo.Items.Add($item.Name) }
+$combo.SelectedIndex = 0
+$form.Controls.Add($combo)
+
+$nickLabel = New-Object System.Windows.Forms.Label
+$nickLabel.Text = 'Офлайн-ник (можно повторить):'
+$nickLabel.Location = New-Object System.Drawing.Point(18, 83)
+$nickLabel.AutoSize = $true
+$form.Controls.Add($nickLabel)
+
+$nickBox = New-Object System.Windows.Forms.TextBox
+$nickBox.Location = New-Object System.Drawing.Point(18, 107)
+$nickBox.Size = New-Object System.Drawing.Size(410, 26)
+$form.Controls.Add($nickBox)
+
+$button = New-Object System.Windows.Forms.Button
+$button.Text = 'Открыть ещё одно окно'
+$button.Location = New-Object System.Drawing.Point(18, 149)
+$button.Size = New-Object System.Drawing.Size(410, 32)
+$form.Controls.Add($button)
+$form.AcceptButton = $button
+
+$button.Add_Click({
+    $button.Enabled = $false
+    $form.Cursor = [System.Windows.Forms.Cursors]::WaitCursor
+    try {
+        New-MultiLaunch ([string]$combo.SelectedItem) $nickBox.Text.Trim() '' | Out-Null
+        $form.Close()
+    }
+    catch { Show-Error $_.Exception.Message }
+    finally { $form.Cursor = [System.Windows.Forms.Cursors]::Default; $button.Enabled = $true }
+})
+
+[void]$form.ShowDialog()
